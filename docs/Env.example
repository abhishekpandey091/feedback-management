# Server
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/feedback_app
JWT_SECRET=your_jwt_secret_here

# Android
# Configure this in the location used by ApiClient/BuildConfig in your project.
# Emulator -> host computer:
BASE_URL=http://10.0.2.2:5000/

# For a physical phone with a local backend, use your computer's LAN IP:
# BASE_URL=http://192.168.x.x:5000/

# For production/deployed backend:
# BASE_URL=https://your-backend.example.com/
